# PostgreSQL
# For Yandex Managed PostgreSQL use the connection string from the cluster page.
# When the backend VM is in the same VPC as the DB, keep the DB host private.
DATABASE_URL="postgresql://user:password@postgres-host:6432/tgmini?schema=public"

# Server
PORT=3000
BACKEND_URL="https://api.example.ru"
FRONTEND_URL="https://app.example.ru"
CORS_ORIGINS="https://app.example.ru,https://admin.example.ru"
JWT_SECRET="replace-with-a-long-random-secret"

# Telegram
TELEGRAM_BOT_TOKEN=""
ADMIN_TELEGRAM_IDS=""
TELEGRAM_AUTH_DISABLED="false"
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Yandex Object Storage
OBJECT_STORAGE_ENDPOINT="https://storage.yandexcloud.net"
OBJECT_STORAGE_REGION="ru-central1"
OBJECT_STORAGE_BUCKET="swa6-products"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Public image origin.
# Prefer a CDN/custom domain later, e.g. https://media.example.ru
# Without a custom domain:
# https://storage.yandexcloud.net/<bucket>
MEDIA_PUBLIC_BASE_URL="https://storage.yandexcloud.net/swa6-products"

# Optional: image migration from old Cloudinary URLs
MIGRATE_IMAGE_HOSTS="res.cloudinary.com"

# Optional order notifications
ORDER_NOTIFY_CHAT_ID=""
ADMIN_TELEGRAM_CHAT_ID=""

# Legacy only: old records may still point to Cloudinary until migration finishes.
# New uploads no longer use these variables.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="zov/products"
